# 실제 값은 Vercel 환경변수에 저장합니다. 로컬에서는 .env.local을 사용하세요.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Google Apps Script 알림을 사용하려면 두 값을 모두 설정하세요.
INQUIRY_NOTIFICATION_URL=
NOVA_NOTIFICATION_SECRET=

# Google Apps Script의 Script Properties에도 같은 NOVA_NOTIFICATION_SECRET을 설정하고,
# NOVA_NOTIFICATION_TO에는 알림 수신자의 이메일 주소를 저장합니다.
